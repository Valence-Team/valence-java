            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Produtor Postman\",\n  \"email\": \"postman-{{$timestamp}}@teste.com\",\n  \"senha\": \"Senha@1234\",\n  \"telefone\": \"(16) 99999-0000\",\n  \"municipio\": \"Ribeirão Preto\",\n  \"uf\": \"SP\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));"

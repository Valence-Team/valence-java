                "ocorrencias"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propriedadeId\": \"{{propriedadeId}}\",\n  \"cultura\": \"MILHO\",\n  \"descricao\": \"Folhas com pústulas alaranjadas e plantas avermelhadas perto da cerca.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "pm.collectionVariables.set('ocorrenciaId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Repetir com a mesma chave (200, sem duplicar)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenProdutor}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ocorrencias",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ocorrencias"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propriedadeId\": \"{{propriedadeId}}\",\n  \"cultura\": \"MILHO\",\n  \"descricao\": \"Folhas com pústulas alaranjadas e plantas avermelhadas perto da cerca.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 com Idempotency-Replayed', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Idempotency-Replayed')).to.eql('true'); });"
                ]
              }
            }
          ]

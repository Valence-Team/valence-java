{
  "info": {
    "name": "Valence API",
    "description": "Coleção da API Java do Valence. Rode as pastas na ordem. Defina baseUrl (padrão http://localhost:8080).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('idempotencyKey')) { pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}')); }"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "tokenProdutor",
      "value": ""
    },
    {
      "key": "tokenVizinho",
      "value": ""
    },
    {
      "key": "tokenAgronomo",
      "value": ""
    },
    {
      "key": "tokenGestor",
      "value": ""
    },
    {
      "key": "propriedadeId",
      "value": ""
    },
    {
      "key": "ocorrenciaId",
      "value": ""
    },
    {
      "key": "alertaId",
      "value": ""
    },
    {
      "key": "postId",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""

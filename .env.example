# Copie este arquivo para .env e preencha os valores reais. O .env nunca vai para o Git.
# A API lê o .env da pasta do projeto ao subir. Linhas comentadas usam o valor padrão.
# O perfil vem da variável de ambiente SPRING_PROFILES_ACTIVE do sistema (padrão dev).

# Perfil: dev (H2 + RabbitMQ no Docker) ou prod (Azure SQL + CloudAMQP)
SPRING_PROFILES_ACTIVE=dev

# Banco do perfil prod (Azure SQL)
DB_URL=jdbc:sqlserver://SEU-SERVIDOR.database.windows.net:1433;database=valence;encrypt=true;trustServerCertificate=false;hostNameInCertificate=*.database.windows.net;loginTimeout=30;
DB_USERNAME=usuario-do-banco
DB_PASSWORD=troque-esta-senha

# JWT (HS256), com pelo menos 32 caracteres. Gere com: openssl rand -base64 48
# Sem ele, no perfil dev a API gera um segredo temporário a cada início.
# JWT_SECRET=cole-aqui-o-segredo-gerado
JWT_EXPIRATION_MINUTES=120

# RabbitMQ. Comentado, usa o RabbitMQ do Docker Compose (amqp://guest:guest@localhost:5672)
# RABBITMQ_URI=amqps://usuario:senha@exemplo.rmq.cloudamqp.com/vhost

# Serviço de IA (Python)
IA_SERVICE_URL=http://localhost:8000
IA_TIMEOUT_SECONDS=10
# IA_API_KEY=mesma-chave-configurada-no-servico-de-ia
IA_CONFIANCA_MINIMA=0.6

# LLM do Spring AI (Groq pelo endpoint compatível com a OpenAI)
LLM_BASE_URL=https://api.groq.com/openai
# LLM_API_KEY=cole-aqui-a-chave-da-groq
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=20
# Esforço de raciocínio dos modelos gpt-oss (low, medium ou high). Mantenha low para responder rápido.
# LLM_REASONING_EFFORT=low
# Para o Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai e LLM_COMPLETIONS_PATH=/chat/completions
# LLM_COMPLETIONS_PATH=/v1/chat/completions

# Regras de negócio
ALERTA_RAIO_KM=10

# Fotos das ocorrências (no App Service: /home/data/fotos)
# FOTOS_DIR=./data/fotos

# Origens liberadas para navegador, separadas por vírgula (comentado = sem CORS; o app nativo não precisa)
# CORS_ORIGENS=http://localhost:8081
